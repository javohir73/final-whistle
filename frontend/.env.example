# Frontend env. Copy to .env.local for local dev.
# Base URL of the backend API the browser calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# FinalWhistle Premium (optional, OFF by default — see DEPLOYMENT.md).
# "true" renders the premium surfaces; keep in lockstep with the backend gate.
NEXT_PUBLIC_BILLING_ENABLED=
# Stripe publishable key (pk_test_… / pk_live_…) for the in-page Payment
# Element. Public by design — the secret key stays on the backend. Leave empty
# and /premium falls back to the hosted-Checkout redirect.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
