# Playwright scratch from `npm run audit:theme` (frontend/scripts/theme-audit.mjs):
# accessibility-tree JSON, full-page screenshots, console logs — tens of MB per
# sweep, regenerate by re-running the audit. The screenshot path is hardcoded
# relative to the frontend/ cwd; --output reports land here too by convention.
# Anchored to frontend/ so an `output/` directory elsewhere stays trackable.
/frontend/output/

# ---- Environment & secrets ----
.env
.env.*
!.env.example

# ---- Data (large / downloaded; keep small seed JSON in pipeline/data) ----
data/raw/*
data/processed/
*.csv
!pipeline/data/*.csv
# committed sample odds fixture for the offline market-benchmark test:
!ml/evaluation/fixtures/*.csv
# committed sample SP1/D1 CSV fixtures for club_results_test.py (League Score
# Predictions Phase 2 multi-division tests):
!pipeline/ingest/testdata/*.csv
# keep the data/raw README tracked (real odds CSVs dropped here stay ignored):
!data/raw/README.md
# committed one-time State of Origin history seed (pipeline/sports/origin_seed.py):
!data/raw/state_of_origin_history.json

# Generated by pipeline/fit_attack_defence.py (offline fit). The Phase-5 gate
# was REFUTED (docs/MODEL-EXPERIMENTS.md), so the store does NOT ship; if a
# future gate run clears, force-add the fitted file with the params flag flip.
ml/models/team_offsets.json

# StatsBomb open-data event/match cache for pipeline/backfill_xg.py — ~314
# match blobs fetched on demand, never committed.
pipeline/data/statsbomb_cache/

